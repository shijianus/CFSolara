# ==============================================================================
# epocanvas sonic Music Gateway — Environment Variables Template (.env.example)
# Copy to `.env` on Linux VPS (`chmod 600 .env`) — NEVER commit real `.env`!
# On Cloudflare Pages configure the same values as encrypted secrets:
#   npx wrangler pages secret put <NAME> --project-name cfsolara
# ==============================================================================

# 1. Inter-Service Security (REQUIRED on both Cloudflare Pages & Linux VPS)
# Generate with: openssl rand -base64 48   (must be >= 32 characters)
SONIC_ENGINE_SECRET=
SONIC_ENGINE_HOST=engine-sonic.epocanvas.tech

# On Cloudflare Pages ONLY (leave empty on Linux VPS to avoid self-loop):
# SONIC_LOCAL_ENGINE_URL=https://engine-sonic.epocanvas.tech

# 2. Runtime & Port Binding (Linux VPS)
SONIC_RUNTIME=linux-engine
SONIC_BIND_PORT=8080
SONIC_REAL_IP=116.25.146.177

# 3. Optional User Cookies (Leave empty for guest/free-catalog mode; mount own account Cookie only if desired)
# These are server-side only. They are never forwarded to arbitrary proxy targets.
NETEASE_COOKIE=
QQ_COOKIE=
KUGOU_COOKIE=

# 4. Provider Switches & Compliance Flags
# Third-party free aggregation upstreams and VIP unblock MUST remain disabled (0) by default.
SONIC_ENABLE_NETEASE=1
SONIC_ENABLE_QQ=1
SONIC_ENABLE_KUGOU=1
SONIC_ENABLE_KUWO=1
SONIC_ENABLE_AMLL=1
SONIC_ENABLE_LRCLIB=1
SONIC_ENABLE_FREE_MATCH=1
SONIC_ENABLE_GDSTUDIO=0
SONIC_ENABLE_LYRIVA=0
SONIC_ENABLE_UNBLOCK=0

# 5. Timeouts, Circuit Breaker & Rate Limiting
# RPM values are clamped; 0/negative values fall back to the documented default.
SONIC_TIMEOUT_MS=8000
SONIC_ENGINE_TIMEOUT_MS=4500
SONIC_CB_FAILURE_THRESHOLD=3
SONIC_CB_COOLDOWN_MS=30000
SONIC_RATE_LIMIT_ANON_RPM=240
SONIC_RATE_LIMIT_AUTH_RPM=600
SONIC_REQUIRE_AUTH=0
# Optional KV namespace binding for cross-instance rate limiting.
# Without it the gateway falls back to a per-isolate in-memory limiter.
# SONIC_RATE_LIMIT_KV=

# 6. Epomail OAuth 2.0 (REQUIRED for login)
# Obtain these from Epomail. There are no built-in defaults.
EPOMAIL_BASE_URL=https://mail.epocanvas.com
EPOMAIL_CLIENT_ID=
EPOMAIL_CLIENT_SECRET=
# Must be registered exactly with Epomail. If omitted, the callback origin must
# be listed in SONIC_ALLOWED_ORIGINS (never taken blindly from the request).
EPOMAIL_REDIRECT_URI=https://sonic.epocanvas.tech/api/auth/callback
# Optional PKCE: set to 0 only if the Epomail deployment does not support S256.
EPOMAIL_PKCE=1

# 7. API Key Signing (REQUIRED)
# Generate with: openssl rand -base64 48   (must be >= 32 characters)
SONIC_SECRET=
# Optional previous secret, used ONLY to verify keys issued before rotation.
# Remove it after the old keys' 30-day lifetime has elapsed.
SONIC_SECRET_PREV=
# Comma/space separated exact origins allowed to build the OAuth callback URL.
SONIC_ALLOWED_ORIGINS=https://sonic.epocanvas.tech,https://sonic.epocanvas.com

# 8. Security switches (defaults are fail-closed; change only with a clear reason)
# Accept ?api_key= / ?key= query credentials. WARNING: query strings leak into
# access logs, browser history, Referer and shared caches. Keep this at 0.
SONIC_ALLOW_QUERY_KEY=0
# Allow outbound plain HTTP in the proxy/SSRF layer. Keep this at 0 in production.
SONIC_ALLOW_HTTP_OUTBOUND=0
