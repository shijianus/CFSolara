# Internal NetEase Protocol Sidecar (Pinned @neteasecloudmusicapienhanced/api@4.41.1, MIT License)
# Strictly internal to Docker Compose network; VIP unblock (`ENABLE_UNBLOCK`) disabled by default.
FROM node:22-alpine
WORKDIR /app

RUN npm install -g @neteasecloudmusicapienhanced/api@4.41.1 && npm cache clean --force

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0
ENV ENABLE_UNBLOCK=false

EXPOSE 3000
# First boot may crash while the xeapi public key is fetched & cached
# (observed in audit: transient "xeapi public key is missing", second boot OK
# because the key persists in the container FS). restart: unless-stopped
# recovers; a generous start-period keeps the healthcheck from declaring the
# sidecar dead (and stalling `depends_on: service_healthy`) during that cycle.
HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3000/inner/version >/dev/null || exit 1

USER node
CMD ["api"]
